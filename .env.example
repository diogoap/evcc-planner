# Copy to .env (ignored by Git). Real environment variables take precedence.
# In production, provide these as environment variables instead.

# EVCC address: only the starting value, until it is saved in Settings →
# Connections. `make test-live` reads it from here.
EVCC_URL=http://192.0.2.10:7070

# One or more secret iCal addresses, separated by commas:
# Google Calendar > Settings > (calendar) > "Secret address in iCal format".
GOOGLE_CALENDAR_ICAL_URL=

# Google Cloud: enable "Routes API" and restrict this key to it.
GOOGLE_MAPS_API_KEY=

# Optional, for daily advice: OpenRouter structures the weekly price outlook
# (without a key a pattern-based stub reads its summary lines).
OPENROUTER_API_KEY=

# Optional, for daily advice: KNMI Data Platform "Open Data API" key
# (developer.dataplatform.knmi.nl > API Catalogue).
KNMI_API_KEY=

# Optional, for an always-on SoC: a Home Assistant long-lived access token
# (Profile > Security > Long-lived access tokens). The address and the car's
# sensors are set in Settings > Connections; HA_URL only sets the starting
# address (`make test-live` reads it from here).
HA_TOKEN=
HA_URL=http://192.0.2.20:8123
